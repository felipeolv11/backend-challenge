# Copie para .env (o Bun carrega o .env automaticamente).
# Os valores batem com o docker-compose.yml.
PORT=3000
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering

# SQS (MiniStack). Credenciais "test" são aceitas pelo emulador.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_QUEUE_NAME=wager-transactions.fifo
WAGER_DLQ_NAME=wager-transactions-dlq.fifo
EVENTS_QUEUE_NAME=wager-events.fifo

# Workers em segundo plano (rodam dentro do processo da API).
ENABLE_SQS_CONSUMER=true
ENABLE_OUTBOX_PUBLISHER=true
ENABLE_PENDING_REFERENCE_WORKER=true
