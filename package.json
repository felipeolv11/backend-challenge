{
  "name": "wagering-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "migration:up": "bun run src/infrastructure/database/migrate.ts up",
    "migration:down": "bun run src/infrastructure/database/migrate.ts down",
    "migration:status": "bun run src/infrastructure/database/migrate.ts status",
    "typecheck": "bun check",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
